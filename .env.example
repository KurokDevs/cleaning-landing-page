# =====================================================================
# Copy this file to `.env` and fill in real values.
# Variables prefixed with PUBLIC_ are exposed to the browser.
# Anything without PUBLIC_ is server-only (never shipped to the client).
# =====================================================================

# Supabase project URL (e.g. https://abcdefgh.supabase.co)
PUBLIC_SUPABASE_URL=

# Public anon key — safe to expose, but with RLS enabled it can't
# read or write contact_requests anymore. Kept here for any future
# client-side reads of non-sensitive tables.
PUBLIC_SUPABASE_ANON_KEY=

# SERVICE-ROLE key — bypasses RLS, full DB access. NEVER expose this.
# Only used by /api/contact serverless function.
# Get it from Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile site key (public, embedded in the widget).
# For local development you can use the always-pass test key:
#   1x00000000000000000000AA
# For production, create a real site at https://dash.cloudflare.com/?to=/:account/turnstile
PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret key (private, server-only).
# For local development you can use the always-pass test secret:
#   1x0000000000000000000000000000000AA
# For production, copy it from the Turnstile dashboard.
TURNSTILE_SECRET_KEY=
