---
import { BeforeAfterSlider } from '../BeforeAfterSlider';
import type { Translation } from '../../i18n/ui';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
---

<section id="resultados" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{t.results.title}</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">{t.results.subtitle}</p>
    </div>
    <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
      <div>
        <h3 class="text-xl font-bold text-gray-900 mb-4 text-center">{t.results.livingRoom}</h3>
        <BeforeAfterSlider
          client:visible
          beforeImage="/assets/messed.jpg"
          afterImage="/assets/cleanned.png"
          beforeLabel={t.results.before}
          afterLabel={t.results.after}
        />
      </div>
      <div>
        <h3 class="text-xl font-bold text-gray-900 mb-4 text-center">{t.results.kitchen}</h3>
        <BeforeAfterSlider
          client:visible
          beforeImage="/assets/cocinasucia.webp"
          afterImage="/assets/cocinalimpia.png"
          beforeLabel={t.results.before}
          afterLabel={t.results.after}
        />
      </div>
    </div>
  </div>
</section>
