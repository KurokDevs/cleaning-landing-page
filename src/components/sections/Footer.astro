---
import Logo from '../Logo.astro';
import type { Lang, Translation } from '../../i18n/ui';

interface Props {
  lang: Lang;
  t: Translation;
}

const { lang, t } = Astro.props;
const base = lang === 'es' ? '/es' : '';
const linkHrefs = ['#servicios', '#nosotros', '#resenas', '#faq', '#contacto'];
const year = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <div>
        <Logo size="h-10 w-10" textSize="text-2xl" variant="light" class="mb-4" />
        <p class="text-gray-400 leading-relaxed">{t.footer.description}</p>
      </div>

      <div>
        <h3 class="text-white font-bold text-lg mb-4">{t.footer.quickLinks}</h3>
        <ul class="space-y-3">
          {t.footer.links.map((link, i) => (
            <li>
              <a href={`${base}/${linkHrefs[i]}`} class="hover:text-blue-500 transition-colors">{link}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-white font-bold text-lg mb-4">{t.footer.contact}</h3>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <span class="mt-1 text-blue-500" aria-hidden="true">📍</span>
            <span class="leading-relaxed">{t.contact.address}<br /><span class="text-sm text-gray-400">{t.footer.coverage}</span></span>
          </li>
          <li class="flex items-center gap-3">
            <span class="text-blue-500" aria-hidden="true">📞</span>
            <a href={`tel:${t.contact.phone.replace(/\s|\(|\)|-/g, '')}`} class="hover:text-blue-500 transition-colors">{t.contact.phone}</a>
          </li>
          <li class="flex items-center gap-3">
            <span class="text-blue-500" aria-hidden="true">✉️</span>
            <a href={`mailto:${t.contact.email}`} class="hover:text-blue-500 transition-colors">{t.contact.email}</a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-white font-bold text-lg mb-4">{t.footer.hours}</h3>
        <ul class="space-y-3">
          <li class="flex justify-between border-b border-gray-800 pb-2">
            <span>{t.footer.monFri}</span>
            <span class="text-white">8:00 AM - 6:00 PM</span>
          </li>
          <li class="flex justify-between border-b border-gray-800 pb-2">
            <span>{t.footer.sat}</span>
            <span class="text-white">9:00 AM - 2:00 PM</span>
          </li>
          <li class="flex justify-between pb-2">
            <span>{t.footer.sun}</span>
            <span class="text-blue-500 font-medium text-sm bg-blue-500/10 px-2 py-1 rounded">{t.footer.closed}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 pt-8 flex justify-center">
      <p class="text-sm text-gray-500">&copy; {year} Neat &amp; Co. {t.footer.copyright}</p>
    </div>
  </div>
</footer>
