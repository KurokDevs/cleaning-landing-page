---
import { ContactForm } from '../ContactForm';
import type { Translation } from '../../i18n/ui';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
---

<section id="contacto" class="py-20 bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-3xl shadow-xl overflow-hidden">
      <div class="grid md:grid-cols-2">
        <div class="bg-blue-600 p-10 text-white flex flex-col justify-between">
          <div>
            <h3 class="text-3xl font-bold mb-4">{t.contact.title}</h3>
            <p class="text-blue-100 mb-8">{t.contact.subtitle}</p>
            <div class="space-y-4">
              <div class="flex items-center gap-3">
                <span aria-hidden="true">📞</span>
                <a href={`tel:${t.contact.phone.replace(/\s|\(|\)|-/g, '')}`} class="hover:underline">{t.contact.phone}</a>
              </div>
              <div class="flex items-center gap-3">
                <span aria-hidden="true">✉️</span>
                <a href={`mailto:${t.contact.email}`} class="hover:underline">{t.contact.email}</a>
              </div>
              <div class="flex items-center gap-3">
                <span aria-hidden="true">📍</span>
                <span>{t.contact.address}</span>
              </div>
            </div>
          </div>
        </div>
        <div class="p-10">
          <ContactForm client:visible t={t.form} />
        </div>
      </div>
    </div>
  </div>
</section>
