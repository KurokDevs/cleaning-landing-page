---
import { Image } from 'astro:assets';
import salaImage from '../../assets/sala.jpg';
import type { Translation } from '../../i18n/ui';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
---

<section id="nosotros" class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="relative h-80 lg:h-full min-h-[400px] rounded-2xl overflow-hidden shadow-xl">
        <Image
          src={salaImage}
          alt={t.about.title}
          class="w-full h-full object-cover"
          widths={[480, 800, 1200]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          loading="lazy"
          format="webp"
          quality={80}
        />
      </div>
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">{t.about.title}</h2>
        <p class="text-lg text-gray-600 mb-6">{t.about.paragraph1}</p>
        <p class="text-lg text-gray-600 mb-8">{t.about.paragraph2}</p>
        <div class="space-y-6">
          {t.about.features.map((f) => (
            <div class="flex items-center gap-4 bg-white p-4 rounded-xl shadow-sm hover:shadow-md transition-shadow">
              <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold" aria-hidden="true">✓</div>
              <div>
                <h4 class="font-bold text-gray-900">{f.title}</h4>
                <p class="text-sm text-gray-500">{f.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
