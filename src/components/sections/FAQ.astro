---
import { FAQAccordion } from '../FAQAccordion';
import type { Translation } from '../../i18n/ui';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
---

<section id="faq" class="py-20 bg-gray-50">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{t.faq.title}</h2>
      <p class="text-lg text-gray-600">{t.faq.subtitle}</p>
    </div>
    <FAQAccordion client:visible items={t.faq.items} />
  </div>
</section>
