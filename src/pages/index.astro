---
import Layout from "../layouts/Layout.astro";
import { ContactForm } from "../components/ContactForm";
import { FAQAccordion } from "../components/FAQAccordion";
import { BeforeAfterSlider } from "../components/BeforeAfterSlider";
---

<Layout title="Limpieza Perfecta | Tu hogar impecable">
	<!-- Navbar -->
	<header class="bg-white shadow-sm sticky top-0 z-50">
		<div
			class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center"
		>
			<div class="flex items-center gap-2">
				<span class="text-2xl font-bold text-blue-600"
					>✨ LimpiezaPerfecta</span
				>
			</div>
			<nav class="hidden md:flex gap-6">
				<a
					href="#servicios"
					class="text-gray-600 hover:text-blue-600 font-medium"
					>Servicios</a
				>
				<a
					href="#nosotros"
					class="text-gray-600 hover:text-blue-600 font-medium"
					>Nosotros</a
				>
				<a
					href="#contacto"
					class="text-gray-600 hover:text-blue-600 font-medium"
					>Contacto</a
				>
			</nav>
			<a
				href="#contacto"
				class="bg-blue-600 text-white px-5 py-2 rounded-lg font-medium hover:bg-blue-700 hover:-translate-y-0.5 hover:shadow-md transition-all duration-300 active:scale-95"
			>
				Cotizar gratis
			</a>
		</div>
	</header>

	<!-- Hero Section -->
	<section class="relative bg-blue-50 py-20 lg:py-32 overflow-hidden">
		<div
			class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 grid lg:grid-cols-2 gap-12 items-center"
		>
			<div>
				<h1
					class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-gray-900 leading-tight mb-6"
				>
					Tu espacio <span class="text-blue-600">impecable</span>,<br
					/> sin esfuerzo.
				</h1>
				<p class="text-lg md:text-xl text-gray-600 mb-8 max-w-lg">
					Ofrecemos servicios de limpieza profunda y mantenimiento
					para hogares y oficinas con personal altamente capacitado y
					de confianza.
				</p>
				<div class="flex flex-col sm:flex-row gap-4">
					<a
						href="#contacto"
						class="bg-blue-600 text-white text-center px-8 py-4 rounded-xl font-bold text-lg hover:bg-blue-700 hover:-translate-y-1 hover:shadow-xl transition-all duration-300 active:scale-95"
					>
						Reserva ahora
					</a>
					<a
						href="#servicios"
						class="bg-white text-blue-600 text-center px-8 py-4 rounded-xl font-bold text-lg border border-blue-100 hover:bg-blue-50 hover:-translate-y-1 hover:shadow-md transition-all duration-300 active:scale-95"
					>
						Ver servicios
					</a>
				</div>
				<div class="mt-8 flex items-center gap-4 text-sm text-gray-500">
					<div class="flex -space-x-2">
						<!-- Placeholder avatars -->
						<div
							class="w-8 h-8 rounded-full bg-blue-200 border-2 border-white"
						>
						</div>
						<div
							class="w-8 h-8 rounded-full bg-blue-300 border-2 border-white"
						>
						</div>
						<div
							class="w-8 h-8 rounded-full bg-blue-400 border-2 border-white"
						>
						</div>
					</div>
					<p>Más de <strong>500+</strong> clientes felices</p>
				</div>
			</div>
			<!-- Shadcn Card in Hero -->
			<div
				class="relative h-64 sm:h-80 lg:h-full min-h-[400px] flex items-center justify-center"
			>
				<div
					class="bg-white p-6 rounded-2xl shadow-xl max-w-sm w-full border border-gray-100 transform rotate-2 hover:rotate-0 transition duration-300"
				>
					<div class="flex items-center gap-4 mb-4">
						<div
							class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center text-green-600 text-xl"
						>
							✓
						</div>
						<div>
							<p class="font-bold text-gray-900">
								Limpieza completada
							</p>
							<p class="text-sm text-gray-500">Hace 2 minutos</p>
						</div>
					</div>
					<p class="text-sm text-gray-600 italic mb-2">
						"Increíble trabajo. Mi casa quedó reluciente y el
						personal fue súper amable. ¡100% recomendado!"
					</p>
					<div
						class="mt-6 pt-4 border-t border-gray-100 flex justify-between items-center"
					>
						<span class="text-yellow-400">★★★★★</span>
						<a
							href="#resenas"
							class="text-sm font-medium text-blue-600 hover:text-blue-700 hover:underline cursor-pointer"
							>Ver reseñas</a
						>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Services Section -->
	<section id="servicios" class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-16">
				<h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
					Nuestros Servicios
				</h2>
				<p class="text-lg text-gray-600 max-w-2xl mx-auto">
					Soluciones de limpieza adaptadas a tus necesidades
					específicas.
				</p>
			</div>

			<div class="grid md:grid-cols-3 gap-8">
				<!-- Service 1 -->
				<div
					class="bg-gray-50 rounded-2xl p-8 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 cursor-pointer"
				>
					<div
						class="w-14 h-14 bg-blue-100 rounded-xl flex items-center justify-center text-blue-600 text-2xl mb-6"
					>
						🏠
					</div>
					<h3 class="text-xl font-bold mb-3">Limpieza Residencial</h3>
					<p class="text-gray-600 mb-4">
						Servicio regular o profundo para tu casa o departamento.
						Barrido, trapeado, desinfección de baños y cocinas.
					</p>
				</div>

				<!-- Service 2 -->
				<div
					class="bg-gray-50 rounded-2xl p-8 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 cursor-pointer"
				>
					<div
						class="w-14 h-14 bg-blue-100 rounded-xl flex items-center justify-center text-blue-600 text-2xl mb-6"
					>
						🏢
					</div>
					<h3 class="text-xl font-bold mb-3">Limpieza Comercial</h3>
					<p class="text-gray-600 mb-4">
						Mantenimiento de oficinas y locales comerciales para
						crear un ambiente de trabajo saludable y profesional.
					</p>
				</div>

				<!-- Service 3 -->
				<div
					class="bg-gray-50 rounded-2xl p-8 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 cursor-pointer"
				>
					<div
						class="w-14 h-14 bg-blue-100 rounded-xl flex items-center justify-center text-blue-600 text-2xl mb-6"
					>
						✨
					</div>
					<h3 class="text-xl font-bold mb-3">Limpieza Profunda</h3>
					<p class="text-gray-600 mb-4">
						Ideal para mudanzas, fin de obra o limpieza de
						primavera. Remoción de manchas difíciles y sanitización
						total.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- About Us Section -->
	<section id="nosotros" class="py-20 bg-gray-50">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid lg:grid-cols-2 gap-12 items-center">
				<!-- Placeholder Image -->
				<div
					class="relative h-80 lg:h-full min-h-[400px] rounded-2xl overflow-hidden shadow-xl bg-gray-200 flex items-center justify-center"
				>
					<span class="text-gray-400 font-medium"
						>Imagen de tu equipo o empresa</span
					>
				</div>
				<!-- Content -->
				<div>
					<h2
						class="text-3xl md:text-4xl font-bold text-gray-900 mb-6"
					>
						Más que limpieza, brindamos tranquilidad
					</h2>
					<p class="text-lg text-gray-600 mb-6">
						En LimpiezaPerfecta, somos un equipo de profesionales
						apasionados por el orden y la higiene. Llevamos años
						transformando hogares y oficinas en espacios saludables,
						brillantes y acogedores.
					</p>
					<p class="text-lg text-gray-600 mb-8">
						Nos diferenciamos por nuestra atención al detalle, el
						uso de productos de la más alta calidad, y nuestro
						estricto proceso de selección de personal. Nos importa
						tu espacio tanto como a ti.
					</p>

					<div class="space-y-6">
						<div
							class="flex items-center gap-4 bg-white p-4 rounded-xl shadow-sm hover:shadow-md transition-shadow"
						>
							<div
								class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold"
							>
								✓
							</div>
							<div>
								<h4 class="font-bold text-gray-900">
									Personal de confianza
								</h4>
								<p class="text-sm text-gray-500">
									Equipo verificado y altamente capacitado.
								</p>
							</div>
						</div>
						<div
							class="flex items-center gap-4 bg-white p-4 rounded-xl shadow-sm hover:shadow-md transition-shadow"
						>
							<div
								class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold"
							>
								✓
							</div>
							<div>
								<h4 class="font-bold text-gray-900">
									Productos seguros
								</h4>
								<p class="text-sm text-gray-500">
									Opciones ecológicas amigables con mascotas.
								</p>
							</div>
						</div>
						<div
							class="flex items-center gap-4 bg-white p-4 rounded-xl shadow-sm hover:shadow-md transition-shadow"
						>
							<div
								class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold"
							>
								✓
							</div>
							<div>
								<h4 class="font-bold text-gray-900">
									Garantía de calidad
								</h4>
								<p class="text-sm text-gray-500">
									Si no estás feliz, lo repasamos sin costo
									extra.
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Resultados (Antes y Después) Section -->
	<section id="resultados" class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-16">
				<h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
					Resultados que hablan por sí solos
				</h2>
				<p class="text-lg text-gray-600 max-w-2xl mx-auto">
					Desliza para ver la transformación de los espacios antes y
					después de nuestro servicio de limpieza profunda.
				</p>
			</div>

			<div class="grid md:grid-cols-2 gap-8 lg:gap-12">
				<!-- Example 1 -->
				<div>
					<h3
						class="text-xl font-bold text-gray-900 mb-4 text-center"
					>
						Limpieza de Sala de Estar
					</h3>
					<BeforeAfterSlider
						beforeImage="/assets/messed.jpg"
						afterImage="/assets/cleanned.png"
						client:load
					/>
				</div>
				<!-- Example 2 -->
				<div>
					<h3
						class="text-xl font-bold text-gray-900 mb-4 text-center"
					>
						Limpieza de Cocina
					</h3>
					<BeforeAfterSlider
						beforeImage="/assets/cocinasucia.webp"
						afterImage="/assets/cocinalimpia.png"
						client:load
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- Testimonials / Reviews Section -->
	<section id="resenas" class="py-20 bg-blue-600 text-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-16">
				<h2 class="text-3xl md:text-4xl font-bold mb-4">
					Lo que dicen nuestros clientes
				</h2>
				<p class="text-lg text-blue-100 max-w-2xl mx-auto">
					La satisfacción de quienes confían en nosotros es nuestra
					mejor garantía.
				</p>
			</div>

			<div class="grid md:grid-cols-3 gap-8">
				<!-- Review 1 -->
				<div
					class="bg-white text-gray-900 rounded-2xl p-8 shadow-xl hover:-translate-y-2 transition-transform duration-300"
				>
					<div class="flex items-center gap-4 mb-6">
						<div
							class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center font-bold text-blue-600 text-lg"
						>
							MR
						</div>
						<div>
							<h4 class="font-bold text-lg">María Rodríguez</h4>
							<div class="text-yellow-400 text-sm">★★★★★</div>
						</div>
					</div>
					<p class="text-gray-600 italic">
						"¡Excelente servicio! Contraté la limpieza profunda para
						mi nueva casa y la dejaron impecable. El equipo fue muy
						profesional y puntual."
					</p>
				</div>

				<!-- Review 2 -->
				<div
					class="bg-white text-gray-900 rounded-2xl p-8 shadow-xl hover:-translate-y-2 transition-transform duration-300"
				>
					<div class="flex items-center gap-4 mb-6">
						<div
							class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center font-bold text-blue-600 text-lg"
						>
							CG
						</div>
						<div>
							<h4 class="font-bold text-lg">Carlos Gómez</h4>
							<div class="text-yellow-400 text-sm">★★★★★</div>
						</div>
					</div>
					<p class="text-gray-600 italic">
						"Llevamos meses trabajando con ellos para el
						mantenimiento de nuestra oficina y siempre encontramos
						todo perfecto al llegar. Muy recomendados."
					</p>
				</div>

				<!-- Review 3 -->
				<div
					class="bg-white text-gray-900 rounded-2xl p-8 shadow-xl hover:-translate-y-2 transition-transform duration-300"
				>
					<div class="flex items-center gap-4 mb-6">
						<div
							class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center font-bold text-blue-600 text-lg"
						>
							AL
						</div>
						<div>
							<h4 class="font-bold text-lg">Ana López</h4>
							<div class="text-yellow-400 text-sm">★★★★★</div>
						</div>
					</div>
					<p class="text-gray-600 italic">
						"Me encanta llegar del trabajo y que mi casa huela a
						limpio. Son de total confianza y muy detallistas con
						todo. No los cambio por nada."
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- FAQ Section -->
	<section id="faq" class="py-20 bg-gray-50">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
					Preguntas Frecuentes
				</h2>
				<p class="text-lg text-gray-600">
					Resolvemos tus dudas principales antes de contratar nuestro
					servicio.
				</p>
			</div>

			<FAQAccordion client:load />
		</div>
	</section>

	<!-- Contact Section -->
	<section id="contacto" class="py-20 bg-gray-50">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="bg-white rounded-3xl shadow-xl overflow-hidden">
				<div class="grid md:grid-cols-2">
					<div
						class="bg-blue-600 p-10 text-white flex flex-col justify-between"
					>
						<div>
							<h3 class="text-3xl font-bold mb-4">
								Contáctanos hoy
							</h3>
							<p class="text-blue-100 mb-8">
								Déjanos tus datos y te enviaremos una cotización
								personalizada sin compromiso.
							</p>

							<div class="space-y-4">
								<div class="flex items-center gap-3">
									<span>📞</span>
									<span>+1 234 567 890</span>
								</div>
								<div class="flex items-center gap-3">
									<span>✉️</span>
									<span>contacto@limpiezaperfecta.com</span>
								</div>
								<div class="flex items-center gap-3">
									<span>📍</span>
									<span
										>Ciudad Central, Av. Principal 123</span
									>
								</div>
							</div>
						</div>
					</div>
					<div class="p-10">
						<ContactForm client:load />
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Footer -->
	<footer class="bg-gray-900 text-gray-300 pt-16 pb-8">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div
				class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12"
			>
				<!-- Brand & Social -->
				<div>
					<span class="text-2xl font-bold text-white mb-4 block"
						>✨ LimpiezaPerfecta</span
					>
					<p class="text-gray-400 mb-6 leading-relaxed">
						Transformando hogares y oficinas en espacios impecables,
						saludables y acogedores. Tu tranquilidad es nuestra
						prioridad.
					</p>
					<div class="flex gap-4">
						<!-- Facebook Icon -->
						<a
							href="#"
							class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center hover:bg-blue-600 hover:text-white transition-all duration-300 hover:-translate-y-1"
						>
							<span class="sr-only">Facebook</span>
							<svg
								class="w-5 h-5"
								fill="currentColor"
								viewBox="0 0 24 24"
								aria-hidden="true"
								><path
									fill-rule="evenodd"
									d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"
									clip-rule="evenodd"></path>
							</svg>
						</a>
						<!-- Instagram Icon -->
						<a
							href="#"
							class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center hover:bg-blue-600 hover:text-white transition-all duration-300 hover:-translate-y-1"
						>
							<span class="sr-only">Instagram</span>
							<svg
								class="w-5 h-5"
								fill="currentColor"
								viewBox="0 0 24 24"
								aria-hidden="true"
								><path
									fill-rule="evenodd"
									d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"
									clip-rule="evenodd"></path>
							</svg>
						</a>
					</div>
				</div>

				<!-- Links -->
				<div>
					<h3 class="text-white font-bold text-lg mb-4">
						Enlaces Rápidos
					</h3>
					<ul class="space-y-3">
						<li>
							<a
								href="#servicios"
								class="hover:text-blue-500 transition-colors"
								>Nuestros Servicios</a>
						</li>
						<li>
							<a
								href="#nosotros"
								class="hover:text-blue-500 transition-colors"
								>Sobre Nosotros</a>
						</li>
						<li>
							<a
								href="#resenas"
								class="hover:text-blue-500 transition-colors"
								>Testimonios</a>
